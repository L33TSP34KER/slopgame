# Copy this file to local.properties (which is never committed) and fix the path.
#
# sdk.dir must point at an Android SDK containing:
#   * platform 34          (compileSdk / targetSdk)
#   * build-tools          (whatever AGP 8.5.2 asks for)
#   * cmake;3.22.1         (or the version AGP picks automatically)
#   * ndk;26.1.10909125    (or pass -Pndk.version=<installed version>)
sdk.dir=/home/YOUR_USER/Android/Sdk

# AGP 8 reads the NDK from android.ndkVersion / -Pndk.version, so ndk.dir is
# deliberately not used here (it is deprecated).  If you really need it:
# ndk.dir=/home/YOUR_USER/Android/Sdk/ndk/26.1.10909125
