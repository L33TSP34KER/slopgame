<?xml version="1.0" encoding="utf-8"?>
<!--
  API 27+ variant: identical to res/values/themes.xml plus the display-cutout
  mode.  The fullscreen surface is allowed to extend into the cutout; the insets
  are still reported to the core through gc_resize, so the game can keep gameplay
  inside the safe area anyway.
-->
<resources>
    <style name="Theme.GameNative" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
